# 复制本文件为 .env 并填入真实密钥（.env 已被 .gitignore 排除，不会上传）

# 智谱 GLM（唯一 LLM 供应商：规划/扩写/翻译）
# 申请地址: https://open.bigmodel.cn
GLM_API_KEY=你的智谱API密钥
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_DEFAULT_MODEL=glm-4-flash
GLM_STRONG_MODEL=glm-4-plus

# Unsplash 图片API
# 申请地址: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=你的Unsplash密钥

# Tavily 联网搜索API（可选：缺失时自动降级为纯AI生成）
# 申请地址: https://tavily.com
TAVILY_API_KEY=你的Tavily密钥
# 联网搜索全局开关：1=开启（默认），0=关闭
TAVILY_SEARCH_ENABLED=1

# 通用AI配置
LLM_MAX_RETRIES=3
LLM_TIMEOUT=60

# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
